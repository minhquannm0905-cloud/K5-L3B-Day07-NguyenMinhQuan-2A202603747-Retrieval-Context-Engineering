# Online OpenAI-compatible API. Copy to .env and insert real values.
RAG_API_BASE=https://api.openai.com/v1
RAG_API_KEY=
RAG_CHAT_MODEL=
RAG_EMBEDDING_MODEL=

# Local alternative (for example Ollama's OpenAI-compatible endpoint):
# RAG_API_BASE=http://localhost:11434/v1
# RAG_API_KEY=
# RAG_CHAT_MODEL=<installed local chat model>
# RAG_EMBEDDING_MODEL=<installed local embedding model>
